#!/usr/bin/env bash
# Start the Remote Control session, resuming the latest real conversation.
# Called by claude-agent.service inside tmux.
# Usage: claude-agent-start [--new] [--dry-run]
#   --new      start a fresh conversation instead of resuming
#   --dry-run  only print the command that would run
set -euo pipefail

# Remote Control session name: one per VM, so several VMs differ in the app
name="claude-$(uname -n | cut -d. -f1)"
workdir="$HOME"
# Transcripts live in ~/.claude/projects/<workdir with / replaced by ->
projdir="$HOME/.claude/projects/${workdir//\//-}"

new=0 dry=0
for arg in "$@"; do
  case "$arg" in
    --new) new=1 ;;
    --dry-run) dry=1 ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

# Newest transcript with at least one user message. Remote Control leaves
# empty stub sessions on every start, so plain --continue may pick a stub.
sid=""
if [ "$new" -eq 0 ] && [ -d "$projdir" ]; then
  while IFS= read -r f; do
    if grep -q '"type":"user"' "$f"; then
      sid="$(basename "$f" .jsonl)"
      break
    fi
  done < <(ls -t "$projdir"/*.jsonl 2>/dev/null)
fi

cmd=(claude --remote-control "$name")
[ -n "$sid" ] && cmd+=(--resume "$sid")

if [ "$dry" -eq 1 ]; then
  printf '%q ' "${cmd[@]}"; echo
  exit 0
fi

# Trust the working folders before every start. The installer can only do this
# when ~/.claude.json already exists; on a fresh VM it appears at first login,
# and the "trust this folder?" dialog would block the unattended session.
python3 -I - "$HOME/.claude.json" "$workdir" "$HOME/github" <<'PY' || echo "claude-agent-start: could not record folder trust" >&2
import json, os, sys, tempfile
p, dirs = sys.argv[1], sys.argv[2:]
d = json.load(open(p)) if os.path.exists(p) else {}
pr = d.setdefault("projects", {})
if all(pr.get(x, {}).get("hasTrustDialogAccepted") for x in dirs):
    sys.exit(0)
for x in dirs:
    pr.setdefault(x, {})["hasTrustDialogAccepted"] = True
fd, t = tempfile.mkstemp(dir=os.path.dirname(p))
with os.fdopen(fd, "w") as f:
    json.dump(d, f, indent=2)
os.chmod(t, 0o600)
os.replace(t, p)
PY

cd "$workdir"
exec "${cmd[@]}"
