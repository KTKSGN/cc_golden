#!/usr/bin/env bash
# Включает аудит запуска программ (execve) для всех учётных записей агентов: членов группы agents.
# Реальные пользователи (с рабочим паролем) в аудит не попадают. Правила берутся из состава группы,
# поэтому скрипт перезапускается при изменении /etc/group (claude-audit-refresh.path) и при установке.
set -euo pipefail
RULES=/etc/audit/rules.d/50-agents.rules
tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
{
  echo "# Создано claude-audit-refresh: аудит запуска программ учётными записями группы agents. Не править вручную."
  members="$(getent group agents | cut -d: -f4 | tr ',' ' ')"
  for u in $members; do
    uid="$(id -u "$u" 2>/dev/null)" || continue
    [ "$uid" -ge 1000 ] || continue
    # L = пароль заблокирован, NP = пароля нет: агентская запись. P = рабочий пароль: живой пользователь, пропускаем.
    # Состояние не определено (нет прав): считаем агентской записью, лучше записать лишнее, чем пропустить.
    st="$(passwd -S "$u" 2>/dev/null | awk '{print $2}' || true)"
    case "$st" in P) echo "# пропущен $u: рабочий пароль (реальный пользователь)"; continue ;; esac
    echo "-a always,exit -F arch=b64 -S execve -F uid=$uid -k agents-exec"
    if [ "$(uname -m)" = x86_64 ]; then echo "-a always,exit -F arch=b32 -S execve -F uid=$uid -k agents-exec"; fi
  done
} >"$tmp"
install -o root -g root -m 0640 "$tmp" "$RULES"
augenrules --load >/dev/null
